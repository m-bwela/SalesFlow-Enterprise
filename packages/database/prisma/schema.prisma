generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum UserStatus {
  PENDING
  ACTIVE
  SUSPENDED
  DISABLED
  ARCHIVED
}

enum OrganizationStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum MembershipStatus {
  INVITED
  ACTIVE
  SUSPENDED
  REMOVED
}

enum DocumentStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum SalesOrderStatus {
  DRAFT
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum OutletType {
  SHOP
  RESTAURANT
  KIOSK
  BAR
  OTHER
}

enum OrderSupplySource {
  DISTRIBUTOR
  FACTORY
}

enum RoleCode {
  ADMIN
  SUPER_ADMIN
  RSM
  GT_TSM
  MT_TSM
  MTSR
  ASR
  DISTRIBUTOR
  HORECA
  SUPPORT
}

enum ScopeType {
  GLOBAL
  REGION
  TERRITORY
  DISTRIBUTOR
  WAREHOUSE
}

// ─── Models ──────────────────────────────────────────────────────────────────

model User {
  id              String     @id @default(uuid()) @db.Uuid
  email           String     @unique
  displayName     String
  firstName       String?
  surname         String?
  phoneNumber     String?
  profileImageUrl String?
  departmentId    String?    @db.Uuid
  transportType   String?
  homeRegion      String?
  city            String?
  streetName      String?
  blockNumber     String?
  nationalIdFrontPath String?
  nationalIdBackPath  String?
  lockedUntil     DateTime?
  passwordHash    String?
  status          UserStatus @default(ACTIVE)
  emailVerifiedAt DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  memberships      Membership[]
  sessions         Session[]
  createdDocuments Document[]   @relation("DocumentCreatedBy")
  ownedDocuments   Document[]   @relation("DocumentOwner")
  createdSalesOrders SalesOrder[] @relation("SalesOrderCreatedBy")
  createdOutlets   Outlet[]      @relation("OutletCreatedBy")
  loginAttempts   LoginAttempt[]
  updatedShiftSettings AsrShiftSetting[] @relation("AsrShiftUpdatedBy")
  department      Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  auditLogs        AuditLog[]   @relation("AuditActor")

  @@index([status])
  @@index([departmentId])
  @@index([lockedUntil])
  @@map("users")
}

model Session {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @db.Uuid
  tokenHash  String    @unique
  expiresAt  DateTime
  createdAt  DateTime  @default(now())
  lastSeenAt DateTime?
  revokedAt  DateTime?
  ipAddress  String?
  userAgent  String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model Document {
  id             String         @id @default(uuid()) @db.Uuid
  organizationId String         @db.Uuid
  ownerId        String         @db.Uuid
  createdById    String         @db.Uuid
  title          String
  status         DocumentStatus @default(DRAFT)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  deletedAt      DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  owner        User         @relation("DocumentOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  createdBy    User         @relation("DocumentCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  auditLogs    AuditLog[]

  @@index([organizationId])
  @@index([organizationId, status])
  @@index([ownerId])
  @@map("documents")
}

model AuditLog {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String?  @db.Uuid
  actorId        String?  @db.Uuid
  action         String
  resourceType   String?
  resourceId     String?
  requestId      String?
  metadata       Json?
  createdAt      DateTime @default(now())

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  actor        User?         @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  Document     Document?     @relation(fields: [documentId], references: [id])
  documentId   String?       @db.Uuid

  @@index([organizationId, createdAt])
  @@index([actorId, createdAt])
  @@index([resourceType, resourceId])
  @@map("audit_logs")
}

model Organization {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  code      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  regions     Region[]
  territories Territory[]
  memberships Membership[]
  documents   Document[]
  products    Product[]
  outlets     Outlet[]
  salesOrders SalesOrder[]
  departments Department[]
  asrShiftSetting AsrShiftSetting?
  auditLogs   AuditLog[]

  @@map("organizations")
}

model Department {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  name           String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  users        User[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("departments")
}

model LoginAttempt {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String?  @db.Uuid
  email      String
  successful Boolean  @default(false)
  ipAddress  String?
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([email, createdAt])
  @@index([successful, createdAt])
  @@map("login_attempts")
}

model AsrShiftSetting {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @unique @db.Uuid
  closeStart     String   @default("23:00")
  closeEnd       String   @default("05:30")
  reopenAt       String   @default("06:00")
  updatedById    String?  @db.Uuid
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  updatedBy    User?        @relation("AsrShiftUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  @@map("asr_shift_settings")
}

model Region {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  name           String
  code           String   @unique
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  territories  Territory[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@map("regions")
}

model Territory {
  id             String   @id @default(uuid()) @db.Uuid
  regionId       String   @db.Uuid
  organizationId String   @db.Uuid
  name           String
  code           String
  shortCode      String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  region       Region        @relation(fields: [regionId], references: [id], onDelete: Cascade)
  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  distributors Distributor[]

  @@unique([regionId, code])
  @@unique([organizationId, shortCode])
  @@index([regionId])
  @@index([organizationId])
  @@map("territories")
}

model Distributor {
  id          String   @id @default(uuid()) @db.Uuid
  territoryId String   @db.Uuid
  name        String
  code        String
  phoneNumber String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  territory  Territory   @relation(fields: [territoryId], references: [id], onDelete: Restrict)
  warehouses Warehouse[]
  outlets    Outlet[]
  salesOrders SalesOrder[]

  @@unique([territoryId, code])
  @@index([territoryId])
  @@map("distributors")
}

model Warehouse {
  id            String   @id @default(uuid()) @db.Uuid
  distributorId String   @db.Uuid
  name          String
  code          String
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  distributor Distributor @relation(fields: [distributorId], references: [id], onDelete: Restrict)

  @@unique([distributorId, code])
  @@index([distributorId])
  @@map("warehouses")
}

model Product {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  sku            String
  name           String
  category       String?
  unitOfMeasure  String   @default("unit")
  unitPrice      Decimal  @db.Decimal(12, 2)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  orderItems   SalesOrderItem[]

  @@unique([organizationId, sku])
  @@index([organizationId, isActive])
  @@map("products")
}

model Outlet {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  distributorId  String   @db.Uuid
  code           String
  name           String
  type           OutletType @default(OTHER)
  address        String?
  phoneNumber    String?
  imageUrl       String?
  coolerCount    Int        @default(0)
  createdById    String?    @db.Uuid
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  distributor  Distributor  @relation(fields: [distributorId], references: [id], onDelete: Restrict)
  createdBy    User?        @relation("OutletCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  salesOrders  SalesOrder[]

  @@unique([organizationId, code])
  @@index([organizationId, isActive])
  @@index([distributorId])
  @@map("outlets")
}

model SalesOrder {
  id               String           @id @default(uuid()) @db.Uuid
  organizationId   String           @db.Uuid
  outletId         String           @db.Uuid
  distributorId    String           @db.Uuid
  createdById      String           @db.Uuid
  orderNumber      String
  status           SalesOrderStatus @default(CONFIRMED)
  currency         String           @default("KES") @db.VarChar(3)
  orderDate        DateTime         @default(now())
  expectedDeliveryAt DateTime?
  deliveredAt      DateTime?
  cancelledAt      DateTime?
  paymentMethod    String?
  supplySource     OrderSupplySource @default(DISTRIBUTOR)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  outlet       Outlet           @relation(fields: [outletId], references: [id], onDelete: Restrict)
  distributor  Distributor      @relation(fields: [distributorId], references: [id], onDelete: Restrict)
  createdBy    User             @relation("SalesOrderCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  items        SalesOrderItem[]

  @@unique([organizationId, orderNumber])
  @@index([organizationId, orderDate, status])
  @@index([distributorId, orderDate])
  @@index([outletId, orderDate])
  @@index([status, deliveredAt])
  @@index([supplySource, orderDate])
  @@map("sales_orders")
}

model SalesOrderItem {
  id            String   @id @default(uuid()) @db.Uuid
  salesOrderId  String   @db.Uuid
  productId     String   @db.Uuid
  productName   String
  productSku    String
  quantity      Decimal  @db.Decimal(12, 3)
  unitPrice     Decimal  @db.Decimal(12, 2)
  createdAt     DateTime @default(now())

  salesOrder SalesOrder @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)
  product    Product    @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([salesOrderId])
  @@index([productId])
  @@map("sales_order_items")
}

model Role {
  id          String   @id @default(uuid()) @db.Uuid
  code        RoleCode @unique
  name        String
  description String?
  isSystem    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  memberships     MembershipRole[]
  rolePermissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique
  name        String
  description String?
  isSystem    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String @db.Uuid
  permissionId String @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

model Membership {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @db.Uuid
  organizationId String   @db.Uuid
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  roles MembershipRole[]

  @@unique([userId, organizationId])
  @@index([organizationId])
  @@index([userId])
  @@map("memberships")
}

model MembershipRole {
  id            String    @id @default(uuid()) @db.Uuid
  membershipId  String    @db.Uuid
  roleId        String    @db.Uuid
  scopeType     ScopeType
  regionId      String?   @db.Uuid
  territoryId   String?   @db.Uuid
  distributorId String?   @db.Uuid
  warehouseId   String?   @db.Uuid
  startsAt      DateTime  @default(now())
  endsAt        DateTime?
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  membership Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  role       Role       @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@unique([membershipId, roleId])
  @@index([roleId])
  @@index([regionId])
  @@index([territoryId])
  @@index([distributorId])
  @@index([warehouseId])
  @@index([isActive, startsAt, endsAt])
  @@map("membership_roles")
}
